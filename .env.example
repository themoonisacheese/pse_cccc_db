# CCCC DB — Environment Configuration
# Copy this file to .env and fill in your values.

# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://cccc:cccc@db:5432/cccc
DATABASE_URL_SYNC=postgresql+psycopg2://cccc:cccc@db:5432/cccc
POSTGRES_USER=cccc
POSTGRES_PASSWORD=cccc
POSTGRES_DB=cccc

# ── App ─────────────────────────────────────────────────────
DEBUG=true
SECRET_KEY=change-this-to-a-random-string

# ── Stack Exchange OAuth2 ───────────────────────────────────
# Register your app at https://stackapps.com/apps/oauth/register
SE_CLIENT_ID=
SE_CLIENT_SECRET=
SE_KEY=
# The redirect URI must match what you registered on StackApps.
# For local dev: http://localhost:8000/auth/callback
SE_OAUTH_REDIRECT=http://localhost:8000/auth/callback

# ── Authorization ───────────────────────────────────────────
# Comma-separated SE user IDs of room owners who can write clues.
# Find your SE user ID at https://api.stackexchange.com/2.3/me (after auth)
# or look at your profile URL on puzzling.stackexchange.com.
# Leave empty to allow all authenticated users (useful for testing).
ROOM_OWNER_IDS=

# ── Pagination ──────────────────────────────────────────────
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=500
