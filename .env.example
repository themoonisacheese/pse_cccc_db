# CCCC DB — Environment Configuration
# Copy this file to .env and fill in your values.

# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://cccc:cccc@db:5432/cccc
DATABASE_URL_SYNC=postgresql+psycopg2://cccc:cccc@db:5432/cccc
POSTGRES_USER=cccc
POSTGRES_PASSWORD=cccc
POSTGRES_DB=cccc

# ── App ─────────────────────────────────────────────────────
DEBUG=true
SECRET_KEY=change-this-to-a-random-string

# ── Stack Exchange OAuth2 ───────────────────────────────────
# Register your app at https://stackapps.com/apps/oauth/register
SE_CLIENT_ID=
SE_CLIENT_SECRET=
# App-level API key for anonymous requests.
# Authenticated users' tokens take priority over this key.
SE_KEY=
# The redirect URI must match what you registered on StackApps.
SE_OAUTH_REDIRECT=http://localhost:8000/api/auth/callback
# SE site used for user lookups and moderator checks.
SE_SITE=puzzling.stackexchange.com
# The CCCC room id on chat.stackexchange.com.
SE_CHAT_ROOM_ID=14524

# ── SE Chat Bot Account ────────────────────────────────────
# Email+password for a bot account used to authenticate with
# chat.stackexchange.com (bypasses Cloudflare).  Used for:
#   - Room owner detection (fetches /rooms/info/{roomID})
#   - Transcript parsing (fetches message content via RSS search feed)
#   - The chat ingest daemon
# Leave empty to disable chat features.
SE_BOT_EMAIL=
SE_BOT_PASSWORD=

# ── Authorization ───────────────────────────────────────────
# Comma-separated SE user IDs of room owners.
# Reserved / NOT currently enforced: login only grants admin/editor rights to
# diamond moderators, and admins grant editor access to others through /admin.
ROOM_OWNER_IDS=

# ── Pagination ──────────────────────────────────────────────
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=500

# ── Solution Ingest (Stage 2) ──────────────────────────────
# Optional OpenAI-compatible endpoint used only to *extract* answers from
# wordplay messages. If LLM_BASE_URL/LLM_MODEL are unset the LLM worker is a
# no-op and only deterministic extraction runs.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_RETRIES=5
LLM_BACKOFF_BASE=2.0

# Reserved settings (currently unused):
#   SOLUTION_AUTO_ACCEPT_THRESHOLD — 0.0 means nothing is auto-accepted.
#   SOLUTION_NOISE_USER_IDS — window noise filtering is not wired to config yet.
SOLUTION_AUTO_ACCEPT_THRESHOLD=0.0
SOLUTION_NOISE_USER_IDS=
