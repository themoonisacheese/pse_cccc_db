# CCCC DB — Environment Configuration
# Copy this file to .env and fill in your values.

# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://cccc:cccc@db:5432/cccc
DATABASE_URL_SYNC=postgresql+psycopg2://cccc:cccc@db:5432/cccc
POSTGRES_USER=cccc
POSTGRES_PASSWORD=cccc
POSTGRES_DB=cccc

# ── App ─────────────────────────────────────────────────────
DEBUG=true
SECRET_KEY=change-this-to-a-random-string

# ── Stack Exchange OAuth2 ───────────────────────────────────
# Register your app at https://stackapps.com/apps/oauth/register
SE_CLIENT_ID=
SE_CLIENT_SECRET=
# App-level API key for anonymous requests.
# Authenticated users' tokens take priority over this key.
SE_KEY=
# The redirect URI must match what you registered on StackApps.
SE_OAUTH_REDIRECT=http://localhost:8000/api/auth/callback

# ── SE Chat Bot Account ────────────────────────────────────
# Email+password for a bot account used to authenticate with
# chat.stackexchange.com (bypasses Cloudflare).  Used for:
#   - Room owner detection (fetches /rooms/info/{roomID})
#   - Transcript parsing (fetches message content via RSS search feed)
# Leave empty to disable chat features (room owner check falls
# back to ROOM_OWNER_IDS allowlist).
SE_BOT_EMAIL=
SE_BOT_PASSWORD=

# ── Authorization ───────────────────────────────────────────
# Comma-separated SE user IDs of room owners who can write clues.
# Leave empty to rely on automatic room-owner detection via the
# chat API (requires SE_BOT_EMAIL and SE_BOT_PASSWORD).
ROOM_OWNER_IDS=

# ── Pagination ──────────────────────────────────────────────
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=500
